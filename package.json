{
  "name": "character-forge",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @character-forge/web",
    "build:web": "npm run build --workspace @character-forge/web",
    "lint:web": "npm run lint --workspace @character-forge/web",
    "test:web": "npm run test --workspace @character-forge/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
